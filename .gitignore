# Machine-local symlinks into .agents/skills — they resolve only on the machine that made them.
/.claude/
skills-lock.json

# Local planning / handoffs — private, never committed.
.context/

# Working docs that are plans/audits, not the shipped design record — they go stale the day
# after they are written and read as commitments they are not.
docs/PLATFORM-BALANCE-PLAN.md
docs/context/interface/*-plan.md
docs/context/interface/*-audit-*.md
docs/assets/restyle-*.png
docs/context/interface/*-proposal.md
.codegraph/

# e2e harness scratch (see e2e-server.sh) — the DB is disposable, never commit it.
e2e.db*

# Generated usage dashboards — regenerate with scripts/usage_report.py, never commit.
/reports/

# Review scratch: a prompt handed to an external reviewer, and its runner. Useful while a branch is
# in review, meaningless after it merges.
/.codex-review-prompt.md
/.codex-review.sh

# Scratch file used to compose commit messages (heredocs are blocked in this harness).
/.git-commit-msg
